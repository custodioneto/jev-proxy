#!/usr/bin/env bash
set -euo pipefail

# Resolve o diretório do projeto a partir da localização deste script.
# Se estiver em ~/.local/bin, aponta para ~/.local/share/jev-proxy.
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ "${SCRIPT_DIR}" == "${HOME}/.local/bin" ]]; then
  PROJECT_DIR="${HOME}/.local/share/jev-proxy"
else
  PROJECT_DIR="${SCRIPT_DIR}"
fi

ENV_FILE="${PROJECT_DIR}/.env"
VENV_DIR="${PROJECT_DIR}/venv"

# Se a chave não estiver exportada no shell atual, tenta carregar do .env seguro.
if [[ -z "${OPENROUTER_API_KEY:-}" ]]; then
  if [[ -f "${ENV_FILE}" ]]; then
    echo "[run-jev-proxy] OPENROUTER_API_KEY não encontrada no shell; carregando ${ENV_FILE}"
    set -a
    # shellcheck source=/dev/null
    source "${ENV_FILE}"
    set +a
  fi
fi

if [[ -z "${OPENROUTER_API_KEY:-}" ]]; then
  echo "[run-jev-proxy] AVISO: OPENROUTER_API_KEY não está configurada."
  echo "[run-jev-proxy] Defina a variável de ambiente no host ou crie ${ENV_FILE} com:"
  echo ""
  echo "    OPENROUTER_API_KEY=sk-or-v1-..."
  echo ""
  echo "[run-jev-proxy] Abortando."
  exit 1
fi

cd "${PROJECT_DIR}"

# Preferência: ambiente virtual local (100% local, sem Nix)
if [[ -d "${VENV_DIR}" && -x "${VENV_DIR}/bin/python3" ]]; then
  echo "[run-jev-proxy] Usando ambiente virtual local: ${VENV_DIR}"
  exec "${VENV_DIR}/bin/python3" "${PROJECT_DIR}/server.py"
fi

# Fallback: Python do sistema (requer pacotes instalados globalmente)
echo "[run-jev-proxy] Usando Python do sistema."
echo "[run-jev-proxy] Dica: crie um venv local com: python3 -m venv venv && venv/bin/pip install -r requirements.txt"
exec python3 "${PROJECT_DIR}/server.py"
