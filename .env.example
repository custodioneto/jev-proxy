# Copie este arquivo para .env e preencha com seus valores reais.
# O arquivo .env NUNCA deve ser versionado (já está no .gitignore).

OPENROUTER_API_KEY=sk-or-v1-sua-chave-openrouter
TYPESAFE_API_KEY=vcp-sua-chave-typesafe

# Endpoint do motor de decisão TypeSafe Jev
JEV_ENDPOINT_URL=https://api.typesafe.ai/v1/decision

# Modelos de roteamento (hierarquia do árbitro, por precedência)
# 1. Imagens + tools -> MODEL_TOOL_USE_VISION
# 2. Tools/functions -> MODEL_TOOL_USE
# 3. Imagens         -> MODEL_VISION
# 4. Contexto longo  -> MODEL_LONG_CONTEXT
# 5. Alta complexidade -> MODEL_COMPLEX
# 6. Código intermediário -> MODEL_INTERMEDIATE
# 7. Trivial/econômico -> MODEL_SIMPLE
MODEL_TOOL_USE_VISION=moonshotai/kimi-k3
MODEL_TOOL_USE=deepseek/deepseek-chat
MODEL_VISION=qwen/qwen-2.5-vl-72b-instruct
MODEL_LONG_CONTEXT=moonshotai/kimi-k2.7-code
MODEL_COMPLEX=moonshotai/kimi-k3
MODEL_INTERMEDIATE=qwen/qwen-2.5-coder-32b-instruct
MODEL_SIMPLE=qwen/qwen-2.5-7b-instruct

# Tempo de cache da lista de modelos do OpenRouter (em segundos)
OPENROUTER_MODELS_CACHE_TTL=60
